[Unit]
Description=NLH214 first-boot lab provisioner (runs once, needs campus network)
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/nlh214-provisioned

[Service]
Type=exec
ExecStart=/opt/nlh214-refresh/autoinstall/firstboot/run-provision.sh
# network-online.target fires before campus DHCP/DNS is really usable; run-provision.sh
# waits internally, and if it still fails, retry rather than give up until provisioned.
Restart=on-failure
RestartSec=60
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
